# 复制本文件为 .env，填入真实值后使用（.env 不会上传到 Git）
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env

# ── 必填 ──────────────────────────────────────────────
# 高德地图 Web 服务 key：https://console.amap.com/dev/key/app 免费申请
AMAP_KEY=your_amap_key_here

# ── 云端模型模式（可选）────────────────────────────────
# 阿里云百炼 DashScope key（qwen-plus 走云端时需要）
# 也可以不写在这里，改用系统环境变量 DASHSCOPE_API_KEY（系统环境变量优先）
DASHSCOPE_API_KEY=your_dashscope_key_here

# 以下均可留空，默认值与云端模式一致；仅当需要自定义模型/端点时填写
# TRAVEL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TRAVEL_LLM_MODEL=qwen-plus

# ── 本地 Ollama 模式（可选）────────────────────────────
# 本地模式不需要真实 key，任意占位值即可（start_agent_local.bat 会自动设置）
# TRAVEL_LLM_BASE_URL=http://localhost:11434/v1
# TRAVEL_LLM_MODEL=qwen3-travel
# TRAVEL_LLM_API_KEY=ollama
